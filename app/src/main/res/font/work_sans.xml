<?xml version="1.0" encoding="utf-8"?>
<!-- Work Sans family, three embedded faces. The resolver picks by textStyle + textFontWeight:
       textStyle="normal"            -> weight 400 -> Work Sans Regular
       textStyle="normal" + tFW=500  -> weight 500 -> Work Sans Medium
       textStyle="bold"              -> weight 700 -> Work Sans Bold  -->
<font-family
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <font
        android:fontStyle="normal"
        android:fontWeight="400"
        android:font="@font/work_sans_regular"
        app:fontStyle="normal"
        app:fontWeight="400"
        app:font="@font/work_sans_regular" />

    <font
        android:fontStyle="normal"
        android:fontWeight="500"
        android:font="@font/work_sans_medium"
        app:fontStyle="normal"
        app:fontWeight="500"
        app:font="@font/work_sans_medium" />

    <font
        android:fontStyle="normal"
        android:fontWeight="700"
        android:font="@font/work_sans_bold"
        app:fontStyle="normal"
        app:fontWeight="700"
        app:font="@font/work_sans_bold" />

</font-family>
