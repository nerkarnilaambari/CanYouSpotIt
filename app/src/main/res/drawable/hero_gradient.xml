<?xml version="1.0" encoding="utf-8"?>
<!-- Home hero background. Vertical top->bottom (hero_gradient_start -> _end), angle 270.
     Bottom corners rounded. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="@color/hero_gradient_start"
        android:endColor="@color/hero_gradient_end" />

    <corners
        android:bottomLeftRadius="32dp"
        android:bottomRightRadius="32dp" />

</shape>
