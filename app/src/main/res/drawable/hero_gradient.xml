<?xml version="1.0" encoding="utf-8"?>
<!-- Home hero background. Vertical (top -> bottom): hero_gradient_start at the top,
     hero_gradient_end at the bottom. angle 270 = straight down, which dithers most
     smoothly of the GradientDrawable orientations. Bottom corners rounded so the hero
     reads as a distinct panel above the sage background. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="@color/hero_gradient_start"
        android:endColor="@color/hero_gradient_end" />

    <corners
        android:bottomLeftRadius="32dp"
        android:bottomRightRadius="32dp" />

</shape>
