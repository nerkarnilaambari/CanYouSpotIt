<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher-icon foreground: a terracotta ring with two bone pause-bars, centred on the
     108x108 canvas. Everything stays inside the ~66dp safe circle. Terracotta #C46C4A is
     inlined; bars use ic_launcher_bars. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Closed ring: centre (54,54), radius 27, stroked (not filled), no gap. -->
    <path
        android:strokeColor="#C46C4A"
        android:strokeWidth="3.2"
        android:fillColor="#00000000"
        android:pathData="M54,27 A27,27 0 1 1 54,81 A27,27 0 1 1 54,27 Z" />

    <!-- Pause bars: two vertical bone capsules, 8 wide x 29 tall, r=4, 6.8 apart,
         centred on (54,54). -->
    <path
        android:fillColor="@color/ic_launcher_bars"
        android:pathData="M42.6,43.5 A4,4 0 0 1 50.6,43.5 L50.6,64.5 A4,4 0 0 1 42.6,64.5 Z M57.4,43.5 A4,4 0 0 1 65.4,43.5 L65.4,64.5 A4,4 0 0 1 57.4,64.5 Z" />

</vector>
