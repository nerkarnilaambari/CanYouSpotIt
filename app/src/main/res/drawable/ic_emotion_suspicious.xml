    android:width="44dp"
    android:height="44dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- Head: oval outline, centered ~(100,95), ~104 wide x 130 tall -->
    <path
        android:pathData="M48,95 A52,65 0 1 0 152,95 A52,65 0 1 0 48,95"
        android:strokeColor="@color/forest_shade"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Eyebrows: right at a slight wary angle, left flat and level -->
    <path
        android:pathData="M67,78 L89,78"
        android:strokeColor="@color/forest_shade"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M111,74 L133,82"
        android:strokeColor="@color/forest_shade"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Eyes: narrow flat lines (squint) -->
    <path
        android:pathData="M70,97 L86,97"
        android:strokeColor="@color/forest_shade"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M114,97 L130,97"
        android:strokeColor="@color/forest_shade"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Mouth: short flat neutral line -->
    <path
        android:pathData="M88,130 L112,130"
        android:strokeColor="@color/forest_shade"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

