<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_sage"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== HERO ===== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/hero_gradient">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingTop="76dp"
                android:paddingBottom="40dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CAN YOU SPOT IT?"
                    android:textAppearance="@style/TextAppearance.CanYouSpotIt.Body"
                    android:textColor="@color/sage_mist_text"
                    android:textSize="12sp"
                    android:letterSpacing="0.16"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/tvHeroHeadline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Got a message that feels off?"
                    android:textAppearance="@style/TextAppearance.CanYouSpotIt.Headline"
                    android:textColor="@color/bone"
                    android:lineSpacingExtra="9dp"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Paste it below for an instant check."
                    android:textAppearance="@style/TextAppearance.CanYouSpotIt.Body"
                    android:textColor="@color/sage_mist_text"
                    android:layout_marginBottom="28dp" />

                <TextView
                    android:id="@+id/btnGoToScanner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/pill_cta"
                    android:text="Scan a message"
                    android:textAppearance="@style/TextAppearance.CanYouSpotIt.ButtonLabel"
                    android:textColor="@color/on_accent_cta"
                    android:paddingStart="30dp"
                    android:paddingEnd="30dp"
                    android:paddingTop="15dp"
                    android:paddingBottom="15dp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <FrameLayout
                android:id="@+id/btnGoToSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="56dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/chip_circle"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Privacy and data settings">

                <ImageView
                    android:id="@+id/imgPrivacyLock"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_lock"
                    android:importantForAccessibility="no" />

            </FrameLayout>

        </FrameLayout>

        <!-- ===== SECONDARY ===== -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="28dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/accent_secondary">

            <LinearLayout
                android:id="@+id/btnGoToLearn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Learn to Spot It"
                    android:textAppearance="@style/TextAppearance.CanYouSpotIt.ButtonLabel"
                    android:textColor="@color/forest_shade"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Practice scams with example messages"
                    android:textAppearance="@style/TextAppearance.CanYouSpotIt.Body"
                    android:textColor="@color/forest_shade" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Learn the warning signs, so you can spot a scam when one reaches you."
                    android:textAppearance="@style/TextAppearance.CanYouSpotIt.Body"
                    android:textColor="@color/forest_shade"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>
