<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_sage">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp"
        android:layout_marginTop="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Can You Spot It?"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/forest_shade"
            android:layout_marginBottom="28dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/sage_mist"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:id="@+id/tvConsentTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Before we start"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="@color/forest_shade"
                    android:layout_marginBottom="12dp" /><TextView
                    android:id="@+id/tvConsentBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="We check your messages to help you spot scams — right here on your phone."
                    android:textSize="15sp"
                    android:textColor="@color/forest_shade"
                    android:lineSpacingExtra="6dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/moss_green"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your privacy"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/bone"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="If you agree, we save your scan results on this device only, to help track your progress over time. Nothing is ever sent anywhere else, and nothing leaves your phone."
                    android:textSize="15sp"
                    android:textColor="@color/bone"
                    android:lineSpacingExtra="6dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnAgree"
            android:layout_width="280dp"
            android:layout_height="52dp"
            android:text="Agree and Continue"
            android:textSize="15sp"
            android:textColor="@color/bone"
            android:backgroundTint="@color/kombu_green"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/Widget.MaterialComponents.Button"
            app:cornerRadius="26dp"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/btnDecline"
            android:layout_width="280dp"
            android:layout_height="52dp"
            android:text="Use Without Saving Data"
            android:textSize="14sp"
            android:textColor="@color/bone"
            android:backgroundTint="@color/cafe_noir"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/Widget.MaterialComponents.Button"
            app:cornerRadius="26dp" />

    </LinearLayout>

</ScrollView>
