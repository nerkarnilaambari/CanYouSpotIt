<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/accent_lilac_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Can You Spot It?"
            android:textAppearance="@style/TextAppearance.CanYouSpotIt.Headline"
            android:textColor="@color/forest_shade"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Intro card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/accent_lilac_card"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvConsentTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Before we start"
                    android:textAppearance="@style/TextAppearance.CanYouSpotIt.ButtonLabel"
                    android:textColor="@color/forest_shade"
                    android:textSize="18sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvConsentBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="We check your messages to help you spot scams — right here on your phone."
                    android:textAppearance="@style/TextAppearance.CanYouSpotIt.Body"
                    android:textColor="@color/forest_shade"
                    android:lineSpacingExtra="6dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Privacy-details card. -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/accent_dusty_pink"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your privacy"
                    android:textAppearance="@style/TextAppearance.CanYouSpotIt.ButtonLabel"
                    android:textColor="@color/forest_shade"
                    android:textSize="18sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="If you agree, we save your scan results on this device only, to help track your progress over time. Nothing is ever sent anywhere else, and nothing leaves your phone."
                    android:textAppearance="@style/TextAppearance.CanYouSpotIt.Body"
                    android:textColor="@color/forest_shade"
                    android:lineSpacingExtra="6dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnAgree"
            android:layout_width="280dp"
            android:layout_height="52dp"
            android:text="Agree and Continue"
            android:textAppearance="@style/TextAppearance.CanYouSpotIt.ButtonLabel"
            android:textColor="@color/on_accent_cta"
            android:textAllCaps="false"
            android:backgroundTint="@color/accent_cta"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/Widget.MaterialComponents.Button"
            app:cornerRadius="26dp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnDecline"
            android:layout_width="280dp"
            android:layout_height="52dp"
            android:text="Use Without Saving Data"
            android:textAppearance="@style/TextAppearance.CanYouSpotIt.ButtonLabel"
            android:textColor="@color/forest_shade"
            android:textAllCaps="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="@color/forest_shade"
            app:strokeWidth="1.5dp"
            app:cornerRadius="26dp" />

        <TextView
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:text="Your practice history won't be saved, so the app won't remember your progress."
            android:textAppearance="@style/TextAppearance.CanYouSpotIt.Body"
            android:textColor="@color/forest_shade"
            android:textSize="13sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="10dp" />

    </LinearLayout>

</ScrollView>
