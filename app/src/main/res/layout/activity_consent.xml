<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/cream">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Can You Spot It?"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/kombu_green"
        android:layout_marginBottom="36dp" />

    <TextView
        android:id="@+id/tvConsentTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Before we start"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="14dp" />

    <TextView
        android:id="@+id/tvConsentBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="We check your messages to help you spot scams — right here on your phone. If you agree, we save your scan results on this device only, to help track your progress over time. Nothing is ever sent anywhere else, and nothing leaves your phone."
        android:textSize="16sp"
        android:textColor="@color/text_secondary"
        android:lineSpacingExtra="7dp"
        android:layout_marginBottom="36dp" />

    <Button
        android:id="@+id/btnAgree"
        android:layout_width="280dp"
        android:layout_height="52dp"
        android:text="Agree and Continue"
        android:textSize="15sp"
        android:textColor="@color/bone"
        android:backgroundTint="@color/kombu_green"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        style="@style/Widget.MaterialComponents.Button"
        app:cornerRadius="26dp"
        android:layout_marginBottom="14dp" />

    <Button
        android:id="@+id/btnDecline"
        android:layout_width="280dp"
        android:layout_height="52dp"
        android:text="Use Without Saving Data"
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:backgroundTint="@color/tan"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        style="@style/Widget.MaterialComponents.Button"
        app:cornerRadius="26dp" />

</LinearLayout>
