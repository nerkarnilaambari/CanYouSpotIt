<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_sage">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp"
        android:layout_marginTop="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:text="Learn to Spot It"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/forest_shade"
            android:layout_marginBottom="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:text="Swipe right for Legitimate, left for Scam"
            android:textSize="14sp"
            android:textColor="@color/slate_blue_grey"
            android:layout_marginBottom="20dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:layout_width="320dp"
                android:layout_height="420dp"
                android:layout_gravity="center">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="28dp"
                    app:cardCornerRadius="24dp"
                    app:cardBackgroundColor="@color/moss_green"
                    app:cardElevation="0dp" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="14dp"
                    app:cardCornerRadius="24dp"
                    app:cardBackgroundColor="@color/sage_mist"
                    app:cardElevation="0dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewCards"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <FrameLayout
                    android:id="@+id/resultOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/scrim_rounded_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/resultCard"
                        android:layout_width="320dp"
                        android:layout_height="420dp"
                        android:layout_gravity="center"
                        android:outlineProvider="background"
                        android:clipToOutline="true"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="@color/verdict_safe">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="28dp">

                            <TextView
                                android:id="@+id/tvOverlayVerdict"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@color/bone"
                                android:gravity="center"
                                android:layout_marginBottom="14dp" />

                            <TextView
                                android:id="@+id/tvOverlayExplanation"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="15sp"
                                android:textColor="@color/bone"
                                android:gravity="center"
                                android:lineSpacingExtra="5dp"
                                android:layout_marginBottom="18dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tap to continue"
                                android:textSize="12sp"
                                android:textStyle="italic"
                                android:textColor="@color/sage_mist" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </FrameLayout>

            </FrameLayout>

        </FrameLayout>

    </LinearLayout>

</FrameLayout>
