<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/accent_dusty_pink_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="44dp"
        android:paddingBottom="56dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:text="Learn to Spot It"
            android:textAppearance="@style/TextAppearance.CanYouSpotIt.Headline"
            android:textColor="@color/forest_shade"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvDifficultyChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/chip_accent_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="Easy"
            android:textAppearance="@style/TextAppearance.CanYouSpotIt.ButtonLabel"
            android:textColor="@color/forest_shade"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:text="Swipe right for Legitimate, swipe left for Scam"
            android:textAppearance="@style/TextAppearance.CanYouSpotIt.Body"
            android:textColor="@color/slate_blue_grey"
            android:layout_marginBottom="20dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:layout_width="320dp"
                android:layout_height="match_parent"
                android:layout_gravity="center">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="28dp"
                    app:cardCornerRadius="24dp"
                    app:cardBackgroundColor="@color/moss_green"
                    app:cardElevation="0dp" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="14dp"
                    app:cardCornerRadius="24dp"
                    app:cardBackgroundColor="@color/sage_mist"
                    app:cardElevation="0dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewCards"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <FrameLayout
                    android:id="@+id/resultOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/scrim_rounded_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/resultCard"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:outlineProvider="background"
                        android:clipToOutline="true"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="@color/verdict_safe">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="28dp">

                            <TextView
                                android:id="@+id/tvOverlayVerdict"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:fontFamily="@font/work_sans_bold"
                                android:textSize="20sp"
                                android:textColor="@color/bone"
                                android:gravity="center"
                                android:layout_marginBottom="6dp" />

                            <TextView
                                android:id="@+id/tvOverlayCategory"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textAppearance="@style/TextAppearance.CanYouSpotIt.Body"
                                android:textSize="13sp"
                                android:textStyle="italic"
                                android:textColor="@color/sage_mist_text"
                                android:gravity="center"
                                android:layout_marginBottom="14dp"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/tvOverlayExplanation"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textAppearance="@style/TextAppearance.CanYouSpotIt.Body"
                                android:textSize="15sp"
                                android:textColor="@color/bone"
                                android:gravity="center"
                                android:lineSpacingExtra="5dp"
                                android:layout_marginBottom="18dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tap to continue"
                                android:textAppearance="@style/TextAppearance.CanYouSpotIt.Body"
                                android:textSize="12sp"
                                android:textStyle="italic"
                                android:textColor="@color/sage_mist_text" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </FrameLayout>

            </FrameLayout>

        </FrameLayout>

        <!-- Answer chips: tapping = swiping that direction (same onAnswer path). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">

            <TextView
                android:id="@+id/chipScam"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/chip_outline_bg"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:text="← Scam"
                android:textAppearance="@style/TextAppearance.CanYouSpotIt.ButtonLabel"
                android:textColor="@color/forest_shade"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipLegit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/chip_outline_bg"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:text="Legitimate →"
                android:textAppearance="@style/TextAppearance.CanYouSpotIt.ButtonLabel"
                android:textColor="@color/forest_shade"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
