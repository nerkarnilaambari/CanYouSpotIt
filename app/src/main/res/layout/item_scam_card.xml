<?xml version="1.0" encoding="utf-8"?>
<com.example.canyouspotit.SwipeableCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeableCard"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="24dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@color/learn_swipe_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tvCardMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textAppearance="@style/TextAppearance.CanYouSpotIt.Body"
                android:textColor="@color/forest_shade"
                android:textSize="16sp"
                android:lineSpacingExtra="6dp" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</com.example.canyouspotit.SwipeableCardView>
