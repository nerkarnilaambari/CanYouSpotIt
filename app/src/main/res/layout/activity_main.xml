<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_sage">

    <LinearLayout
        android:id="@+id/contentColumn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Let's Spot It"
            android:textAppearance="@style/TextAppearance.CanYouSpotIt.Headline"
            android:textColor="@color/forest_shade"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paste a message to check it"
            android:textAppearance="@style/TextAppearance.CanYouSpotIt.Body"
            android:textColor="@color/slate_blue_grey"
            android:layout_marginBottom="14dp" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cardMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/cream"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Message"
                    android:textAppearance="@style/TextAppearance.CanYouSpotIt.ButtonLabel"
                    android:textColor="@color/forest_shade"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="4"
                    android:maxLines="6"
                    android:gravity="top"
                    android:hint="Paste the WhatsApp, SMS, or email text here"
                    android:textAppearance="@style/TextAppearance.CanYouSpotIt.Body"
                    android:textColor="@color/forest_shade"
                    android:textColorHint="@color/slate_blue_grey"
                    android:background="@android:color/transparent"
                    android:inputType="textMultiLine" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/accent_periwinkle_card"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Link (optional)"
                    android:textAppearance="@style/TextAppearance.CanYouSpotIt.ButtonLabel"
                    android:textColor="@color/forest_shade"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etLink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Paste a suspicious link here"
                    android:textAppearance="@style/TextAppearance.CanYouSpotIt.Body"
                    android:textColor="@color/forest_shade"
                    android:textColorHint="@color/slate_blue_grey"
                    android:background="@android:color/transparent"
                    android:inputType="textUri" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnScan"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Scan"
            android:textAppearance="@style/TextAppearance.CanYouSpotIt.ButtonLabel"
            android:textColor="@color/on_accent_cta"
            android:textAllCaps="false"
            android:backgroundTint="@color/accent_cta"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/Widget.MaterialComponents.Button"
            app:cornerRadius="28dp"
            android:layout_marginBottom="14dp" />

        <!-- ===== Verdict result card ===== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/moss_green"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvVerdict"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SAFE"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/bone"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvExplanation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="15sp"
                    android:textColor="@color/bone"
                    android:lineSpacingExtra="5dp"
                    android:layout_marginBottom="6dp" />

                <!-- textColor is set per-verdict in ScannerActivity; this is just the design-time default. -->
                <TextView
                    android:id="@+id/tvActionStep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="14sp"
                    android:textStyle="italic"
                    android:textColor="@color/verdict_safe_action" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Continue"
            android:textAppearance="@style/TextAppearance.CanYouSpotIt.ButtonLabel"
            android:textColor="@color/on_accent_cta"
            android:textAllCaps="false"
            android:backgroundTint="@color/accent_cta"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/Widget.MaterialComponents.Button"
            app:cornerRadius="26dp"
            android:layout_marginTop="14dp"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
