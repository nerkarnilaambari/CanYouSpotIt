<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base palette -->
    <color name="cafe_noir">#4C3D19</color>
    <color name="kombu_green">#354024</color>
    <color name="moss_green">#889063</color>
    <color name="bone">#E5D7C4</color>

    <!-- Verdict colors (Activity 1) -->
    <color name="verdict_safe">#2E5931</color>
    <color name="verdict_caution">#D47300</color>
    <color name="verdict_scam">#8B2020</color>

    <!-- Action-step text, one per verdict. CAUTION's is dark, the rest light. -->
    <color name="verdict_safe_action">#EFE8DA</color>
    <color name="verdict_caution_action">#241100</color>
    <color name="verdict_scam_action">#F4E9E1</color>

    <!-- Verdict colour as text on the periwinkle badge. -->
    <color name="verdict_safe_badge">#2E5931</color>
    <color name="verdict_caution_badge">#7A4100</color>
    <color name="verdict_scam_badge">#8B2020</color>

    <!-- Near-black in light mode; values-night keeps bone. -->
    <color name="reflection_text">#16240F</color>

    <!-- Backgrounds -->
    <color name="cream">#FAF3E8</color>

    <!-- Additional palette -->
    <color name="sage_mist">#A2B5A0</color>
    <!-- Matches sage_mist in light mode; lighter in values-night for text on coloured cards. -->
    <color name="sage_mist_text">#A2B5A0</color>
    <color name="slate_blue_grey">#57636B</color>
    <color name="forest_shade">#1F3D2E</color>

    <!-- Launcher-icon colours; no values-night variant. -->
    <color name="ic_launcher_bg">#1F3D2E</color>
    <color name="ic_launcher_bars">#E5D7C4</color>
    <!-- App-wide screen background. -->
    <color name="background_sage">#C2C4B9</color>

    <!-- Home hero + accents. -->
    <color name="hero_gradient_start">@color/forest_shade</color>
    <color name="hero_gradient_end">#C98FA0</color>
    <!-- Lilac secondary-card fill. -->
    <color name="accent_secondary">#A896BE</color>
    <color name="accent_cta">@color/kombu_green</color>
    <color name="on_accent_cta">@color/bone</color>
    <!-- Translucent white, for the hero settings chip. -->
    <color name="chip_bg">#33FFFFFF</color>

    <!-- Settings-row separator. -->
    <color name="divider">#33000000</color>

    <!-- Per screen: lilac = Consent, dusty pink = Learn, periwinkle = Scanner's link field. -->
    <color name="accent_lilac_bg">#E2DAEC</color>
    <color name="accent_lilac_card">#BEACD2</color>
    <color name="accent_dusty_pink_bg">#EEDCDE</color>
    <color name="accent_dusty_pink">#D8B4BA</color>
    <color name="accent_periwinkle_bg">#D4D6EC</color>
    <color name="accent_periwinkle_card">#B4B8DC</color>

    <!-- Unused in light (learn_swipe_card aliases to sage_mist here); declared so the
         values-night override has a base fallback. -->
    <color name="accent_periwinkle_deep">#6B70B0</color>

    <!-- Alias: sage_mist in light, accent_periwinkle_deep in values-night. -->
    <color name="learn_swipe_card">@color/sage_mist</color>

    <!-- Alias: accent_dusty_pink in light, cream at night. -->
    <color name="recap_dialog_card">@color/accent_dusty_pink</color>
</resources>
