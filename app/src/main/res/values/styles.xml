<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base typography: family / weight / size / spacing. Sets forest_shade (the DayNight
         primary) as the default text colour; layouts override the colour where needed. -->
    <style name="TextAppearance.CanYouSpotIt" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/work_sans</item>
        <item name="fontFamily">@font/work_sans</item>
        <item name="android:textColor">@color/forest_shade</item>
    </style>

    <!-- Hero title. Work Sans Bold. -->
    <style name="TextAppearance.CanYouSpotIt.Headline">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- Supporting / descriptive copy (eyebrow, subtitle, secondary-card description).
         Work Sans 400. -->
    <style name="TextAppearance.CanYouSpotIt.Body">
        <item name="android:fontFamily">@font/work_sans_regular</item>
        <item name="fontFamily">@font/work_sans_regular</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <!-- Button labels and the secondary-card title. Work Sans Medium (500). -->
    <style name="TextAppearance.CanYouSpotIt.ButtonLabel">
        <item name="android:fontFamily">@font/work_sans_medium</item>
        <item name="fontFamily">@font/work_sans_medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Activity 3 reflection sentences. Karla Medium Italic. Not currently applied to any view. -->
    <style name="TextAppearance.CanYouSpotIt.Reflection" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/karla</item>
        <item name="fontFamily">@font/karla</item>
        <item name="android:textColor">@color/forest_shade</item>
        <item name="android:textStyle">italic</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

</resources>
